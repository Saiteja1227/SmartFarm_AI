# Copy this file to .env and fill in real values
MONGO_URL=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/
DB_NAME=smartfarm
EMERGENT_LLM_KEY=your_emergent_api_key_here
SECRET_KEY=change_this_to_a_random_secret_key
# Private Admin Dashboard credentials (configure ADMIN_PASSWORD_HASH or ADMIN_PASSWORD)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace_with_strong_admin_password
# Optional PBKDF2/scrypt password hash (takes precedence over ADMIN_PASSWORD if set):
# ADMIN_PASSWORD_HASH=scrypt:32768:8:1$...
# Optional: restrict CORS origins (comma-separated). Defaults to allow all.
# CORS_ORIGINS=https://your-app.onrender.com

